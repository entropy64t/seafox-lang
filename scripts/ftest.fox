function ask(const prompt) {
    write(prompt + " > ");
    return readln();
}

function makeCoffee(const type) {
    writeln("Making coffee...");
    writeln(type, "is ready!");
    return "SUCCESS";
}

function expr(x, y, z) => x + y * z;

writeln(expr(1, 2, 3)); // should be 7

const result = ask("Do you want coffee?");
if (result == "yes") 
    makeCoffee("Espresso");


function fib(const n) {
    if (n < 2) return n;
    return fib(n - 2) + fib(n - 1);
}

const start = getTime();
writeln(fib(35));
writeln("fib(35) took", getTime() - start, "seconds");
