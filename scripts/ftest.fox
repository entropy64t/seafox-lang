var stuff = "example";

function dostuff() {
    print "doing stuff";
    print stuff;
}

writeln("a string,", "and a cat");

function withparams(p1, p2, const p3) {
    print p1 + p2;
    p2 = p3;
    print p2;
    print p3;
}

print dostuff;
print withparams;

dostuff();

